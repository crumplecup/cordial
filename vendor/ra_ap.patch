+    fn attach(&self, live: &sync::Arc<dyn ProcMacroExpander>) -> bool {
+        match self.live.write() {
+            Ok(mut slot) => {
+                *slot = Some(sync::Arc::clone(live));
+                true
+            }
+            Err(_) => false,
+        }
+    }
