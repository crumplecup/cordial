+    match ToolRoots::try_get(db) {
+        Some(existing) => {
+            existing.set_roots(db).with_durability(durability).to(roots);
+        }
+        None => {
+            let _ = ToolRoots::builder(roots).durability(durability).new(db);
+        }
+    }
