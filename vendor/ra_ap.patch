+            }
+            MacroCallKind::Derive { ast_id, derive_attr_index, derive_index, derive_macro_id } => {
+                cx.tag("derive");
+                ast_id.stable_hash(cx);
+                derive_attr_index.stable_hash(cx);
+                derive_index.stable_hash(cx);
+                derive_macro_id.stable_hash(cx);
+            }
+            MacroCallKind::Attr { ast_id, attr_args: _attr_args, censored_attr_ids } => {
+                // The arguments of the attribute decide what it expands to, which is in the items
+                // it makes (names and places), and not in which call this is.
+                cx.tag("attribute");
+                ast_id.stable_hash(cx);
+                censored_attr_ids.stable_hash_attr_ids(cx);
+            }
+        }
+    }
+}
+
+impl crate::AttrMacroAttrIds {
+    fn stable_hash_attr_ids(&self, cx: &mut StableCx<'_>) {
+        let ids: &[AttrId] = self;
+        cx.write_u64(ids.len() as u64);
+        for id in ids {
+            id.stable_hash(cx);
+        }
+    }
+}
+
+impl StableHash for span::SyntaxContext {
+    fn stable_hash(&self, cx: &mut StableCx<'_>) {
+        // The root is one per edition, a fixed number. Any other is made by a macro call, and is
+        // that call, how transparent it made it, the edition, and the context it was made in: the
+        // two contexts it also keeps (with the transparent or semi-transparent marks taken away)
+        // are worked out from those, and add nothing.
+        if self.is_root() {
+            cx.tag("root context");
+            cx.write_plain(&self.edition(cx.db));
+            return;
+        }
+        cx.tag("hygiene context");
+        self.outer_expn(cx.db).map(MacroCallId::from).stable_hash(cx);
+        cx.write_plain(&self.outer_transparency(cx.db));
+        cx.write_plain(&self.edition(cx.db));
+        self.parent(cx.db).stable_hash(cx);
+    }
+}
