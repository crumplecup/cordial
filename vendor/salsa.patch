+impl RestoredSet {
+    /// The edges of the set.
+    pub(crate) fn edges(&self) -> impl Iterator<Item = QueryEdge> + '_ {
+        self.runs.iter().flat_map(|(first, length)| {
+            self.universe[*first as usize..(*first + *length) as usize]
