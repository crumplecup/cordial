+        /// dependencies of the queries it reads as they are now, and so must be valid as of now.
+        pub fn verify_persisted_memos(&self) {
+            self.verify_persisted_memos_part(0, 1);
+        }
+
+        /// Verify the persisted memos that flattening what they read is enough to verify, for the
+        /// ingredients of one part of `parts`: part `part` takes every `parts`th ingredient. It runs
+        /// no query, so the parts may run at once; call it for every part before
+        /// [`Self::verify_persisted_memos_part`], which verifies the rest.
+        pub fn verify_persisted_memos_by_closure_part(&self, part: usize, parts: usize) {
+            let zalsa = self.zalsa();
+            for (index, ingredient) in zalsa
+                .ingredients()
+                .filter(|ingredient| ingredient.is_persistable())
+                .enumerate()
+            {
+                if index % parts.max(1) != part {
+                    continue;
+                }
+                // SAFETY: `self` is the database the ingredient was created with, and the caller
+                // runs no query while the parts run.
+                unsafe {
+                    ingredient
+                        .verify_persisted_by_closure(zalsa, crate::database::RawDatabase::from(self))
+                };
+            }
+        }
+
+        /// The memos of one part of `parts` of every persisted ingredient: part `part` takes every
+        /// `parts`th memo. Calling it for each part, each from a handle of its own on its own
+        /// thread, verifies every memo as [`Self::verify_persisted_memos`] does, with the walks
+        /// through what the memos read shared between the threads as queries are.
+        pub fn verify_persisted_memos_part(&self, part: usize, parts: usize) {
+            let zalsa = self.zalsa();
+            for ingredient in zalsa.ingredients().filter(|ingredient| ingredient.is_persistable()) {
+                // SAFETY: `self` is the database the ingredient was created with.
+                unsafe {
+                    ingredient.verify_persisted(
+                        zalsa,
+                        crate::database::RawDatabase::from(self),
+                        part,
+                        parts,
+                    )
+                };
+            }
+        }
+
+        /// Say that the persisted tracked function `fingerprint` stands for the tracked function
+        /// `query`, both called by the names they are declared with, and taking the same salsa
+        /// struct as their only argument.
+        ///
+        /// A persisted memo that read `query` is then saved as depending on `fingerprint` of the
+        /// same argument, not on everything `query` read. It stays valid across an edit that makes
+        /// `query` read something else and give the same answer, because `fingerprint` is verified
+        /// as a query is: it runs again and, giving the same value as before, does not change.
+        ///
+        /// The value of `fingerprint` must determine what anything can read of the value of
+        /// `query`: if it leaves something out, a memo that read that stays valid when it changes.
+        /// `fingerprint` must be asked for, for each argument `query` was, before a save: where it
+        /// has not been, the save goes through `query` as before. Returns whether both were found.
+        pub fn register_cutoff(&self, query: &str, fingerprint: &str) -> bool {
